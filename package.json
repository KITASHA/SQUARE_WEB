{
  "name": "square-web",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:dry-run": "wrangler deploy --dry-run",
    "types": "wrangler types",
    "check": "node scripts/check-syntax.mjs",
    "lint": "eslint src scripts tests public/site.js",
    "test": "node --test tests/*.test.mjs",
    "validate": "npm run check && npm run lint && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "wrangler": "^4.134.0"
  }
}
